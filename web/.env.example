# Leave STRIPE_* empty to run in "Demo mode (no Stripe keys)".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public base URL used for Stripe success/cancel redirects
APP_URL=http://localhost:3000
# Optional block explorer base URL (no trailing slash). Empty on local chain.
NEXT_PUBLIC_EXPLORER_URL=
# Optional overrides (default: shared/deployment.json + shared/demo-keys.json)
# RPC_URL=http://127.0.0.1:8545
# TREASURY_PRIVATE_KEY=

# Sign-in (Clerk, Google). Leave empty to run in demo mode with the alice/bob switcher.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Secret used to derive each signed-in user's wallet. Keep it private and never change it once users exist.
WALLET_MASTER_SECRET=
# ETH (testnet) the treasury sends each new user's wallet for gas
# USER_GAS_ETH=0.00001
